# ---- Required on Vercel (Backend project -> Settings -> Environment Variables) ----
# Telegram: from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Neon: the connection string from Connect -> copy snippet (use the pooled one)
DATABASE_URL=
# The AI (any OpenAI-compatible API). The AI Lodge workshop values:
LLM_BASE_URL=https://api.apiyi.com/v1
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
# Your frontend's address, so the browser is allowed to call this backend (no trailing slash)
FRONTEND_URL=
# Any long random text you make up. The pinger and the one-time setup link need it.
CRON_SECRET=

# ---- Optional ----
# A second model to fall back to if the first is busy
LLM_FALLBACK_MODEL=
# A BACKUP AI provider, used when the main gateway is down. Only the key is needed (free key: https://aistudio.google.com/apikey).
# Defaults: LLM2_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai and LLM2_MODEL=gemini-flash-lite-latest
LLM2_API_KEY=
# Stops the AI for the day once the estimated spend reaches this (USD). 0 = no cap.
DAILY_BUDGET_USD=5
# Used for the estimate. Keep them at or above your model's real prices (USD per million tokens).
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50
# Skips one lookup if you set your bot's @username (without the @)
TELEGRAM_BOT_USERNAME=

# Wall Street guide, just for you (see DEPLOY.md). Only people who type this code can see it online.
BIWS_ACCESS_CODE=

# ---- Only for running on your own computer ----
# Leave DATABASE_URL empty to use a local SQLite file. PORT is where the site runs.
PORT=5050

# Alerts: your Telegram username (without the @). Message the bot once and it will send errors, learner feedback and /report messages to you.
OWNER_USERNAME=
